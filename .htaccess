RewriteEngine On

# Dominio canónico: https://clinicaviba.com (sin www), que es el que declaran
# las etiquetas canonical, el sitemap y los datos estructurados.
# Ambas condiciones en una sola regla para resolverlo en un único salto 301
# (p. ej. http://www.clinicaviba.com/x va directo a https://clinicaviba.com/x).
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://clinicaviba.com%{REQUEST_URI} [L,R=301]

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
